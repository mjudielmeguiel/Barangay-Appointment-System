@model Barangay_Service_Appointment_System.ViewModels.ResidentDashboardViewModel
@{
    // Existing Profile Picture logic
    bool hasPicture = Model.Resident?.Picture != null && Model.Resident.Picture.Length > 0;
    string pictureUrl = Url.Action("GetProfilePicture", "Home", new { v = Model.Resident?.UpdatedAt?.Ticks ?? 0 })!;
    string defaultPictureUrl = Url.Content("~/images/default-profile.png");

    // NEW Valid ID logic
    bool hasIdFront = Model.Resident?.IdentificationFront != null && Model.Resident.IdentificationFront.Length > 0;
    string idFrontUrl = Url.Action("GetIdentificationFront", "Home", new { v = Model.Resident?.UpdatedAt?.Ticks ?? 0 })!;

    bool hasIdBack = Model.Resident?.IdentificationBack != null && Model.Resident.IdentificationBack.Length > 0;
    string idBackUrl = Url.Action("GetIdentificationBack", "Home", new { v = Model.Resident?.UpdatedAt?.Ticks ?? 0 })!;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barangay Putatan Dashboard</title>
    <link rel="icon" type="image/x-icon" href="~/images/PUTATAN.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
            :root {
                --nav-bg: #131e3d;
                --main-bg: #f5f6f8;
                --text-dark: #333333;
                --text-muted: #777777;
                --border-color: #e3e6f0;
                --primary-blue: #1a2b56;
                --success-green: #22c55e;
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: var(--main-bg);
                margin: 0;
                padding: 0;
                overflow-x: hidden;
            }

            /* Top Navbar */
            .top-navbar {
                background-color: var(--nav-bg);
                color: white;
                padding: 0 16px;
                display: flex;
                align-items: center;
                height: 60px;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1050;
            }

            .navbar-brand-wrapper {
                display: flex;
                align-items: center;
                width: 100%;
            }

            .navbar-logo {
                height: 36px;
                width: 36px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #f8c146;
                background-color: white;
                margin-right: 10px;
                flex-shrink: 0;
            }

            .navbar-title {
                font-size: 0.95rem;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                margin: 0;
            }

            .btn-logout {
                margin-left: auto;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: transparent;
                border: 1px solid rgba(255,255,255,0.35);
                color: #fff;
                padding: 6px 14px;
                border-radius: 6px;
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
                white-space: nowrap;
                flex-shrink: 0;
                transition: background .3s ease, color .3s ease, border-color .3s ease, transform .3s ease;
            }

                .btn-logout:hover {
                    background: #fff;
                    color: var(--nav-bg);
                    border-color: #fff;
                    transform: translateY(-1px);
                }

            .main-content {
                margin-left: 0;
                margin-top: 60px;
                min-height: calc(100vh - 60px);
                background-color: var(--main-bg);
                padding: 24px 16px;
            }

            .content-wrapper {
                max-width: 1500px;
                margin: 0 auto;
                width: 100%;
                padding: 0 10px;
            }

            .profile-card {
                background: white;
                border: 1px solid var(--border-color);
                border-radius: 10px;
                padding: 24px 16px;
                text-align: center;
                margin-bottom: 20px;
                box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            }

            .profile-img-wrapper {
                width: 120px;
                height: 120px;
                border-radius: 50%;
                overflow: hidden;
                margin: 0 auto 15px;
                border: 4px solid #eef2ff;
            }

            .profile-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .profile-name {
                font-size: 1.15rem;
                font-weight: 750;
                color: var(--primary-blue);
                margin-bottom: 5px;
                word-wrap: break-word;
                overflow-wrap: break-word;
                white-space: normal;
                line-height: 1.3;
            }

            .profile-role {
                font-size: 0.75rem;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-bottom: 15px;
            }

            .info-list {
                list-style: none;
                padding: 0;
                margin: 15px 0 0 0;
                text-align: left;
            }

            .info-item {
                display: flex;
                align-items: flex-start;
                padding: 10px 0;
                border-bottom: 1px dashed #f0f0f0;
            }

                .info-item:last-child {
                    border-bottom: none;
                }

            .info-icon {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 12px;
                font-size: 0.9rem;
                flex-shrink: 0;
                margin-top: 2px;
            }

            .info-text {
                flex: 1;
                min-width: 0;
            }

                .info-text p {
                    margin: 0;
                    line-height: 1.4;
                }

            .info-label {
                font-size: 0.75rem;
                color: #888;
                margin-bottom: 2px;
            }

            .info-value {
                font-size: 0.9rem;
                color: #333;
                font-weight: 500;
                overflow-wrap: anywhere;
                word-break: normal;
            }

            .table-card {
                background: white;
                border: 1px solid var(--border-color);
                border-radius: 10px;
                padding: 24px;
                box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            }

            .table-header-title {
                color: var(--primary-blue);
                font-weight: 700;
                font-size: 1.1rem;
            }

            .btn-custom-dark {
                background-color: var(--primary-blue);
                color: white;
                font-size: 0.85rem;
                font-weight: 500;
                border-radius: 6px;
                white-space: nowrap;
                padding: 8px 14px;
                transition: opacity 0.2s;
            }

                .btn-custom-dark:hover {
                    opacity: 0.9;
                    color: #fff;
                }

            .btn-custom-light {
                background-color: #f8f9fa;
                border: 1px solid #ddd;
                color: #333;
                font-size: 0.85rem;
                border-radius: 6px;
                padding: 8px 12px;
            }

            .custom-table {
                width: 100%;
                margin-top: 5px;
            }

                .custom-table th {
                    font-size: 0.8rem;
                    color: var(--text-dark);
                    font-weight: 700;
                    padding: 12px 10px;
                    border-top: 1px solid var(--border-color);
                    border-bottom: 2px solid var(--border-color);
                    background-color: #f8f9fc;
                    white-space: nowrap;
                }

                .custom-table td {
                    font-size: 0.85rem;
                    padding: 12px 10px;
                    color: #444;
                    border-bottom: 1px solid #f0f0f0;
                    vertical-align: middle;
                }

            .empty-table {
                text-align: center;
                padding: 35px 0;
                color: #888;
                font-size: 0.9rem;
            }

            .logout-icon {
                width: 76px;
                height: 76px;
                margin: 0 auto 14px;
                border-radius: 50%;
                background: #fdecea;
                color: #e74c3c;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.9rem;
            }

            .btn-edit-profile {
                background-color: var(--primary-blue);
                color: white;
                border-radius: 6px;
                padding: 8px 12px;
                font-size: 0.85rem;
                width: 100%;
                border: none;
            }

                .btn-edit-profile:hover {
                    opacity: 0.9;
                    color: white;
                }

            .modal-content {
                border: none;
                border-radius: 12px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.08);
            }

            .modal-header {
                border-bottom: 1px solid #eee;
                padding: 16px 24px;
                background: transparent;
            }

            .modal-title {
                font-weight: 600;
                font-size: 1rem;
                color: #111;
            }

            .modal-body {
                padding: 24px;
            }

            .modal-footer {
                border-top: 1px solid #eee;
                padding: 16px 24px;
                background: transparent;
            }

            .form-label {
                font-weight: 500;
                font-size: 0.875rem;
                color: #444;
                margin-bottom: 6px;
            }

            .form-control, .form-select {
                border-radius: 6px;
                border: 1px solid #ddd;
                padding: 8px 12px;
                font-size: 0.875rem;
            }

                .form-control:focus, .form-select:focus {
                    border-color: var(--primary-blue);
                    box-shadow: 0 0 0 2px rgba(26, 43, 86, 0.1);
                }

            .btn-primary {
                background-color: var(--primary-blue);
                border: none;
                padding: 8px 20px;
                font-size: 0.875rem;
                border-radius: 6px;
            }

                .btn-primary:hover {
                    background-color: #152449;
                }

            .btn-secondary {
                background-color: #f1f3f5;
                border: none;
                color: #444;
                padding: 8px 20px;
                font-size: 0.875rem;
                border-radius: 6px;
            }

                .btn-secondary:hover {
                    background-color: #e5e7eb;
                    color: #333;
                }

            .upload-zone {
                border: 2px dashed #ddd;
                border-radius: 8px;
                padding: 20px;
                text-align: center;
                transition: all 0.2s;
                background-color: #f9fafc;
            }

            .section-title {
                font-size: 0.875rem;
                font-weight: 600;
                color: #666;
                text-transform: uppercase;
                letter-spacing: 0.3px;
                margin-bottom: 16px;
                padding-bottom: 8px;
                border-bottom: 1px solid #eee;
            }

            /* Valid ID thumbnails (same look as the profile photo preview) */
            .id-thumb {
                width: 160px;
                height: 100px;
                object-fit: cover;
                display: block;
            }

            .id-thumb-empty {
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px dashed #ddd;
                border-radius: 8px;
                background: #f9fafc;
                color: #bbb;
                font-size: 1.8rem;
            }

            .success-icon-wrapper {
                width: 80px;
                height: 80px;
                margin: 0 auto 16px;
            }

            .success-checkmark {
                width: 80px;
                height: 80px;
            }

            .checkmark-circle {
                stroke: var(--success-green);
                stroke-width: 3;
                stroke-dasharray: 166;
                stroke-dashoffset: 166;
                stroke-linecap: round;
                animation: fill-circle 0.5s ease-in-out forwards;
            }

            .checkmark-check {
                stroke: #fff;
                stroke-width: 3;
                stroke-linecap: round;
                stroke-linejoin: round;
                stroke-dasharray: 48;
                stroke-dashoffset: 48;
                animation: draw-check 0.4s ease-in-out 0.4s forwards;
            }

            @@keyframes fill-circle {
                to {
                    stroke-dashoffset: 0;
                }
            }

            @@keyframes draw-check {
                to {
                    stroke-dashoffset: 0;
                }
            }
    </style>
</head>
<body>
    <!-- Top Navbar -->
    <nav class="top-navbar">
        <div class="navbar-brand-wrapper">
            <img src="~/images/PUTATAN.ico" alt="Barangay Logo" class="navbar-logo">
            <h5 class="navbar-title fw-medium">Barangay Putatan, City of Muntinlupa</h5>
            <button type="button" class="btn-logout" data-bs-toggle="modal" data-bs-target="#logoutModal">
                <i class="fa-solid fa-right-from-bracket"></i><span class="d-none d-sm-inline">Log out</span>
            </button>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-3" role="alert" style="max-width:1500px; margin:0 auto 16px;">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="content-wrapper">
            <div class="row g-4">
                <!-- Left Column: Profile Card -->
                <div class="col-xl-3 col-lg-4">
                    <div class="profile-card">
                        <div class="profile-img-wrapper">
                            @if (hasPicture)
                            {
                                <img src="@pictureUrl" alt="Profile" class="profile-img"
                                     onerror="this.onerror=null;this.src='@defaultPictureUrl';" />
                            }
                            else if (!string.IsNullOrEmpty(Model.Resident?.ProfileImagePath))
                            {
                                <img src="@Model.Resident.ProfileImagePath" alt="Profile" class="profile-img"
                                     onerror="this.onerror=null;this.src='@defaultPictureUrl';" />
                            }
                            else
                            {
                                <img src="~/images/default-profile.png" alt="Profile" class="profile-img">
                            }
                        </div>
                        @{
                            string formattedName = "N/A";
                            if (!string.IsNullOrEmpty(Model.Resident?.FullName))
                            {
                                var nameParts = Model.Resident.FullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                if (nameParts.Length > 1)
                                {
                                    string lastName = nameParts[nameParts.Length - 1];
                                    string firstNames = string.Join(" ", nameParts.Take(nameParts.Length - 1));
                                    formattedName = $"{lastName}, {firstNames}";
                                }
                                else
                                {
                                    formattedName = Model.Resident.FullName;
                                }
                            }
                        }
                        <h5 class="profile-name" title="@formattedName">@formattedName</h5>
                        <p class="profile-role">Barangay Resident</p>
                        <hr style="border-color: #eee; margin: 10px 0;">
                        <ul class="info-list">
                            <li class="info-item">
                                <div class="info-icon" style="background-color: #e6f0ff; color: #4d79ff;"><i class="fa-regular fa-envelope"></i></div>
                                <div class="info-text"><p class="info-label">Email</p><p class="info-value">@Model.Resident?.Email</p></div>
                            </li>
                            <li class="info-item">
                                <div class="info-icon" style="background-color: #fff8e6; color: #ffcc00;"><i class="fa-solid fa-phone"></i></div>
                                <div class="info-text"><p class="info-label">Contact No.</p><p class="info-value">@Model.Resident?.MobileNumber</p></div>
                            </li>
                            <li class="info-item">
                                <div class="info-icon" style="background-color: #ffe6e6; color: #ff4d4d;"><i class="fa-solid fa-location-dot"></i></div>
                                <div class="info-text"><p class="info-label">Address</p><p class="info-value">@Model.Resident?.Address</p></div>
                            </li>
                            <li class="info-item">
                                <div class="info-icon" style="background-color: #e6e6ff; color: #6666ff;"><i class="fa-solid fa-calendar-days"></i></div>
                                <div class="info-text"><p class="info-label">Birthday</p><p class="info-value">@(Model.Resident?.Birthday.HasValue == true ? Model.Resident.Birthday.Value.ToString("MMMM dd, yyyy") : "N/A")</p></div>
                            </li>
                            <li class="info-item">
                                <div class="info-icon" style="background-color: #fffbe6; color: #e6b800;"><i class="fa-solid fa-baby-carriage"></i></div>
                                <div class="info-text"><p class="info-label">Birthplace</p><p class="info-value">@Model.Resident?.BirthPlace</p></div>
                            </li>
                            <li class="info-item">
                                <div class="info-icon" style="background-color: #ffe6eb; color: #ff4d79;"><i class="fa-solid fa-venus-mars"></i></div>
                                <div class="info-text"><p class="info-label">Gender</p><p class="info-value">@Model.Resident?.Gender</p></div>
                            </li>
                            <li class="info-item">
                                <div class="info-icon" style="background-color: #e6e6fa; color: #8c8cbf;"><i class="fa-solid fa-rings-wedding"></i></div>
                                <div class="info-text"><p class="info-label">Civil Status</p><p class="info-value">@Model.Resident?.CivilStatus</p></div>
                            </li>
                        </ul>
                        <button type="button" class="btn btn-edit-profile mt-3" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Edit My Information
                        </button>
                    </div>
                </div>

                <!-- Right Column: Tables -->
                <div class="col-xl-9 col-lg-8">
                    <div class="table-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                            <h5 class="table-header-title mb-0">Appointment & Reports</h5>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-custom-dark" id="btnCreateRequest">
                                    <i class="fa-solid fa-calendar-plus me-1"></i><span>Create Request</span>
                                </button>
                                <button type="button" class="btn btn-custom-dark" id="btnSubmitComplaint">
                                    <i class="fa-solid fa-flag me-1"></i><span>Submit Complaint</span>
                                </button>
                                <a href="@Url.Action("Index", "Home")" class="btn btn-custom-light text-decoration-none text-dark" title="Refresh">
                                    <i class="fa-solid fa-rotate-right"></i>
                                </a>
                            </div>
                        </div>

                        <!-- Appointments Table -->
                        <h6 class="text-muted small fw-semibold mb-2">Appointment Requests</h6>
                        <div class="table-responsive mb-4">
                            <table class="custom-table">
                                <thead>
                                    <tr>
                                        <th>Control No.</th>
                                        <th>Type</th>
                                        <th>Purpose</th>
                                        <th class="d-none d-md-table-cell">Dept</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Appointments != null && Model.Appointments.Any())
                                    {
                                        foreach (var item in Model.Appointments)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">@item.ControlNo</td>
                                                <td>@item.AppointmentType</td>
                                                <td>@item.Purpose</td>
                                                <td class="d-none d-md-table-cell">@item.Department</td>
                                                <td>@(item.PickupDate.HasValue ? item.PickupDate.Value.ToString("MM/dd/yyyy") : (item.DateSubmitted.HasValue ? item.DateSubmitted.Value.ToString("MM/dd/yyyy") : "N/A"))</td>
                                                <td><span class="badge bg-warning text-dark">@item.Status</span></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="6" class="empty-table">No appointment requests yet.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Complaints Table -->
                        <h6 class="text-muted small fw-semibold mb-2">Submitted Complaints</h6>
                        <div class="table-responsive">
                            <table class="custom-table">
                                <thead>
                                    <tr>
                                        <th>Control No.</th>
                                        <th>Type</th>
                                        <th>Title</th>
                                        <th class="d-none d-md-table-cell">Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Complaints != null && Model.Complaints.Any())
                                    {
                                        foreach (var c in Model.Complaints)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">@c.ControlNo</td>
                                                <td>@c.ComplaintType</td>
                                                <td>@c.Title</td>
                                                <td class="d-none d-md-table-cell">@c.DateSubmitted.ToString("MM/dd/yyyy")</td>
                                                <td><span class="badge bg-warning text-dark">@c.Status</span></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="5" class="empty-table">No complaints submitted yet.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- EDIT PROFILE MODAL -->
    <div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editProfileModalLabel">
                        <i class="fa-solid fa-user-pen me-2"></i>Edit Personal Information
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Home" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    <div class="modal-body p-4" style="max-height: 75vh; overflow-y: auto;">
                        <input type="hidden" name="ResidentID" value="@(Model.Resident?.ResidentID ?? 0)" />

                        <h6 class="text-primary fw-bold mb-3">Personal Information</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                                <input type="text" name="FirstName" value="@Model.Resident?.Firstname" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Middle Name</label>
                                <input type="text" name="MiddleName" value="@Model.Resident?.Middlename" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                                <input type="text" name="LastName" value="@Model.Resident?.Lastname" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Suffix</label>
                                <input type="text" name="Suffix" value="@Model.Resident?.Suffix" class="form-control" placeholder="Jr., III" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Birthday <span class="text-danger">*</span></label>
                                <input type="date" name="Birthday" value="@(Model.Resident?.Birthday.HasValue == true ? Model.Resident.Birthday.Value.ToString("yyyy-MM-dd") : "")" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Birthplace <span class="text-danger">*</span></label>
                                <input type="text" name="BirthPlace" value="@Model.Resident?.BirthPlace" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Gender <span class="text-danger">*</span></label>
                                @{
                                    string selectedGender = Model.Resident?.Gender ?? "";
                                }
                                <select name="Gender" class="form-select" required>
                                    <option value="">Select...</option>
                                    <option value="Male" selected="@(selectedGender == "Male")">Male</option>
                                    <option value="Female" selected="@(selectedGender == "Female")">Female</option>
                                    <option value="Other" selected="@(selectedGender == "Other")">Other</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Civil Status <span class="text-danger">*</span></label>
                                @{
                                    string selectedCivilStatus = Model.Resident?.CivilStatus ?? "";
                                }
                                <select name="CivilStatus" class="form-select" required>
                                    <option value="">Select...</option>
                                    <option value="Single" selected="@(selectedCivilStatus == "Single")">Single</option>
                                    <option value="Married" selected="@(selectedCivilStatus == "Married")">Married</option>
                                    <option value="Widowed" selected="@(selectedCivilStatus == "Widowed")">Widowed</option>
                                    <option value="Separated" selected="@(selectedCivilStatus == "Separated")">Separated</option>
                                </select>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Nationality</label>
                                <input type="text" name="Nationality" value="@(string.IsNullOrWhiteSpace(Model.Resident?.Nationality) ? "Filipino" : Model.Resident.Nationality)" class="form-control" />
                            </div>
                        </div>

                        <h6 class="text-primary fw-bold mb-3">Parents Information</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Father's Full Name</label>
                                <input type="text" name="FatherName" value="@Model.Resident?.FatherName" class="form-control" placeholder="Juan Dela Cruz" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mother's Full Name</label>
                                <input type="text" name="MotherName" value="@Model.Resident?.MotherName" class="form-control" placeholder="Maria Dela Cruz" />
                            </div>
                        </div>

                        <h6 class="text-primary fw-bold mb-3">Contact Information</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                <input type="email" name="Email" value="@Model.Resident?.Email" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                                <input type="text" name="MobileNumber" value="@Model.Resident?.MobileNumber" class="form-control" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Complete Address <span class="text-danger">*</span></label>
                                <textarea name="Address" class="form-control" rows="2" required>@Model.Resident?.Address</textarea>
                            </div>
                        </div>

                        <h6 class="text-primary fw-bold mb-3">Photos & Identification</h6>
                        <div class="row g-3">
                            <!-- Profile Photo -->
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Profile Photo</label>
                                <input type="file" name="ProfilePicture" class="form-control bg-light" accept="image/png,image/jpeg,image/webp" />
                                <small class="text-muted d-block mt-1">Upload your profile picture (Max 5MB)</small>
                                <small id="pictureError" class="text-danger fw-semibold d-block mt-1"></small>
                                <img id="picturePreview"
                                     src="@(hasPicture ? pictureUrl : defaultPictureUrl)"
                                     alt="Current Profile" class="mt-2 rounded"
                                     style="width: 100px; height: 100px; object-fit: cover;"
                                     onerror="this.onerror=null;this.src='@defaultPictureUrl';" />
                            </div>

                            <!-- Valid ID (Front) -->
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Valid ID (Front)</label>
                                <input type="file" name="IdentificationFront" class="form-control bg-light" accept="image/png,image/jpeg,image/webp" />
                                <small class="text-muted d-block mt-1">Upload front of valid ID (Max 5MB)</small>
                                <small id="idFrontError" class="text-danger fw-semibold d-block mt-1"></small>
                                <img id="idFrontPreview"
                                     src="@(hasIdFront ? idFrontUrl : "")"
                                     alt="Front ID" class="mt-2 rounded @(hasIdFront ? "" : "d-none")"
                                     style="width: 100px; height: 100px; object-fit: cover; border: 1px solid #ddd;" />
                            </div>

                            <!-- Valid ID (Back) -->
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Valid ID (Back)</label>
                                <input type="file" name="IdentificationBack" class="form-control bg-light" accept="image/png,image/jpeg,image/webp" />
                                <small class="text-muted d-block mt-1">Upload back of valid ID (Max 5MB)</small>
                                <small id="idBackError" class="text-danger fw-semibold d-block mt-1"></small>
                                <img id="idBackPreview"
                                     src="@(hasIdBack ? idBackUrl : "")"
                                     alt="Back ID" class="mt-2 rounded @(hasIdBack ? "" : "d-none")"
                                     style="width: 100px; height: 100px; object-fit: cover; border: 1px solid #ddd;" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light px-4 py-3">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- CREATE APPOINTMENT MODAL -->
    <div class="modal fade" id="createAppointmentModal" tabindex="-1" aria-labelledby="createAppointmentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createAppointmentModalLabel"><i class="fa-solid fa-calendar-plus me-2"></i>Create Appointment Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Home" asp-action="CreateAppointment" method="post" enctype="multipart/form-data">
                    <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">
                        <input type="hidden" name="NewAppointment.ResidentID" value="@(Model.Resident?.ResidentID ?? 0)" />

                        <h6 class="section-title">Appointment & Pickup Details</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Request Type</label>
                                <select asp-for="NewAppointment.RequestType" id="documentServiceSelect" class="form-select" required>
                                    <option value="">Select...</option>
                                    @if (Model.DocumentServicesList != null)
                                    {
                                        foreach (var service in Model.DocumentServicesList)
                                        {
                                            <option value="@service.ServiceName" data-serviceid="@service.ID">@service.ServiceName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Department</label>
                                <select asp-for="NewAppointment.Department" class="form-select" required>
                                    <option value="">Select...</option>
                                    <option value="Lupon Tagapamayapa">Lupon Tagapamayapa</option>
                                    <option value="Social Services">Social Services</option>
                                    <option value="Clearance & Certification">Clearance & Certification</option>
                                    <option value="Treasurer Office">Treasurer Office</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Pickup Date</label>
                                <input type="date" asp-for="NewAppointment.PickupDate" id="txtPickupDate" min="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" required />
                                <small class="text-muted">Weekends and Admin Holidays are disabled.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Pickup Time</label>
                                <input type="time" asp-for="NewAppointment.PickupTime" class="form-control" required />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Purpose</label>
                                <select asp-for="NewAppointment.Purpose" id="purposeSelect" class="form-select" required disabled>
                                    <option value="">Select Service First...</option>
                                    @if (Model.ServiceDetailsList != null)
                                    {
                                        foreach (var detail in Model.ServiceDetailsList)
                                        {
                                            <option value="@detail.Purpose" data-serviceid="@detail.Service_ID">@detail.Purpose</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <h6 class="section-title">Personal Information</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label class="form-label">Full Name</label>
                                <input type="text" value="@Model.Resident?.FullName" class="form-control bg-light" disabled />
                                <input type="hidden" name="NewAppointment.FullName" value="@Model.Resident?.FullName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email Address</label>
                                <input type="text" value="@Model.Resident?.Email" class="form-control bg-light" disabled />
                                <input type="hidden" name="NewAppointment.EmailAddress" value="@Model.Resident?.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <input type="text" value="@Model.Resident?.MobileNumber" class="form-control bg-light" disabled />
                                <input type="hidden" name="NewAppointment.PhoneNumber" value="@Model.Resident?.MobileNumber" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Full Address</label>
                                <textarea class="form-control bg-light" rows="2" disabled>@Model.Resident?.Address</textarea>
                                <input type="hidden" name="NewAppointment.FullAddress" value="@Model.Resident?.Address" />
                            </div>
                        </div>

                        <h6 class="section-title">Proof and Documentation</h6>
                        <div class="upload-zone">
                            <input type="file" name="AppointmentProofPicture" class="form-control bg-light" accept="image/png,image/jpeg,image/webp" />
                            <small class="text-muted d-block mt-2">Upload any required supporting document or receipt photo (Max 5MB)</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SUBMIT COMPLAINT MODAL -->
    <div class="modal fade" id="complaintModal" tabindex="-1" aria-labelledby="complaintModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="complaintModalLabel">Submit Complaint / Report</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Home" asp-action="SubmitComplaint" method="post" enctype="multipart/form-data">
                    <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">
                        <input type="hidden" name="ResidentID" value="@(Model.Resident?.ResidentID ?? 0)" />
                        <input type="hidden" id="hfLatitude" name="Latitude" />
                        <input type="hidden" id="hfLongitude" name="Longitude" />
                        <h6 class="section-title">Complaint Information</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Type of Complaint</label>
                                <select name="ComplaintType" class="form-select" required>
                                    <option value="">Select...</option>
                                    <option value="Illegal Parking">Illegal Parking</option>
                                    <option value="Noise / Disturbance">Noise / Disturbance</option>
                                    <option value="Garbage / Cleanliness">Garbage / Cleanliness</option>
                                    <option value="Dispute / Conflict">Dispute / Conflict</option>
                                    <option value="Threat / Harassment">Threat / Harassment</option>
                                    <option value="Property Damage">Property Damage</option>
                                    <option value="Emergency">Emergency</option>
                                    <option value="Others">Others</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Short Title</label>
                                <input type="text" name="Title" class="form-control" placeholder="Brief description..." required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Full Details</label>
                                <textarea name="Description" class="form-control" rows="4" placeholder="Describe what happened..." required></textarea>
                            </div>
                        </div>
                        <h6 class="section-title">Location & Evidence</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Exact Location</label>
                                <input type="text" id="txtLocation" name="LocationDetails" class="form-control" placeholder="Enter location or allow GPS..." required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Upload Photo / Evidence</label>
                                <div class="upload-zone">
                                    <input type="file" name="ComplaintPhoto" class="form-control bg-light" accept="image/*" style="border: none; padding: 0;" />
                                    <small class="text-muted d-block mt-2">Optional evidence upload (Max 5MB)</small>
                                </div>
                            </div>
                            <div class="col-12 mt-2">
                                <div class="form-check">
                                    <input type="checkbox" name="IsAnonymous" value="true" id="chkAnonymous" class="form-check-input" />
                                    <label class="form-check-label" for="chkAnonymous">
                                        Submit anonymously
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit Complaint</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- LOGOUT CONFIRMATION MODAL -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content">
                <div class="modal-body text-center p-4">
                    <div class="logout-icon"><i class="fa-solid fa-right-from-bracket"></i></div>
                    <h5 class="fw-bold text-dark mb-2" id="logoutModalLabel">Log out?</h5>
                    <p class="text-muted mb-0">Are you sure you want to log out of your account?</p>
                </div>
                <div class="modal-footer justify-content-center border-0 pb-4 gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Home" asp-action="Logout" method="post" id="logoutForm" class="m-0">
                        <button type="submit" class="btn btn-primary">Yes, Log out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- SUCCESS MODAL -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center py-4">
                        <div class="success-icon-wrapper">
                            <svg class="success-checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                                <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none"></circle>
                                <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"></path>
                            </svg>
                        </div>
                        @if ((TempData["IsComplaint"] as bool?) == true)
                        {
                            <h4 class="fw-bold text-dark">Complaint Submitted!</h4>
                        }
                        else if ((TempData["IsProfileUpdate"] as bool?) == true)
                        {
                            <h4 class="fw-bold text-dark">Profile Updated!</h4>
                        }
                        else
                        {
                            <h4 class="fw-bold text-dark">Request Submitted!</h4>
                        }
                        @if (TempData["ControlNo"] != null)
                        {
                            <p class="text-muted mt-3 mb-1">Reference Number:</p>
                            <div class="p-3 bg-light rounded d-inline-block px-4">
                                <h3 class="text-primary fw-bold mb-0">@TempData["ControlNo"]</h3>
                            </div>
                        }
                        <p class="text-muted mt-3">@TempData["SuccessMessage"]</p>
                    </div>
                    <div class="modal-footer justify-content-center border-0 pb-4">
                        <button type="button" class="btn btn-primary px-5" data-bs-dismiss="modal">OK</button>
                    </div>
                </div>
            </div>
        </div>
        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    new bootstrap.Modal(document.getElementById('successModal')).show();
                });
        </script>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            // Load admin holidays passed from backend ViewBag securely
            const adminHolidays = @Html.Raw(Json.Serialize(ViewBag.HolidayDates ?? new List<string>()));

            document.addEventListener("DOMContentLoaded", function() {
                // --- BULLETPROOF DROPDOWN FILTERING ---
                const serviceSelect = document.getElementById('documentServiceSelect');
                const purposeSelect = document.getElementById('purposeSelect');

                if (serviceSelect && purposeSelect) {
                    const purposeData = [];
                    Array.from(purposeSelect.options).forEach(opt => {
                        if (opt.value) {
                            purposeData.push({
                                value: opt.value,
                                text: opt.text,
                                serviceId: opt.getAttribute('data-serviceid')
                            });
                        }
                    });

                    serviceSelect.addEventListener('change', function() {
                        const selectedServiceId = this.options[this.selectedIndex].getAttribute('data-serviceid');

                        purposeSelect.value = "";
                        purposeSelect.innerHTML = '';

                        const defaultOpt = document.createElement('option');
                        defaultOpt.value = '';
                        defaultOpt.text = selectedServiceId ? 'Select Purpose...' : 'Select Service First...';
                        purposeSelect.appendChild(defaultOpt);

                        if (!selectedServiceId) {
                            purposeSelect.disabled = true;
                            return;
                        }

                        purposeSelect.disabled = false;

                        purposeData.forEach(data => {
                            if (data.serviceId === selectedServiceId) {
                                const opt = document.createElement('option');
                                opt.value = data.value;
                                opt.text = data.text;
                                purposeSelect.appendChild(opt);
                            }
                        });
                    });
                }

                // --- WEEKEND & HOLIDAY BLOCKING FOR APPOINTMENTS ---
                const pickupDateInput = document.getElementById('txtPickupDate');
                if (pickupDateInput) {
                    pickupDateInput.addEventListener('change', function() {
                        const selectedDateStr = this.value;
                        if (!selectedDateStr) return;

                        const selectedDate = new Date(selectedDateStr);
                        const dayOfWeek = selectedDate.getDay();

                        // 0 = Sunday, 6 = Saturday
                        if (dayOfWeek === 0 || dayOfWeek === 6) {
                            alert('Appointments cannot be scheduled on weekends.');
                            this.value = '';
                            return;
                        }

                        // Check against admin holidays
                        if (adminHolidays.includes(selectedDateStr)) {
                            alert('This date has been marked as a Holiday by the administrator and is unavailable for appointments.');
                            this.value = '';
                            return;
                        }
                    });
                }
            });

            function checkProfileComplete() {
                const fields = [
                    '@Model.Resident?.Firstname',
                    '@Model.Resident?.Lastname',
                    '@Model.Resident?.Email',
                    '@Model.Resident?.MobileNumber',
                    '@Model.Resident?.Address',
                    '@Model.Resident?.BirthPlace',
                    '@Model.Resident?.Gender',
                    '@Model.Resident?.CivilStatus',
                    '@(Model.Resident?.Birthday.HasValue)'
                ];
                return fields.every(f => f !== '' && f !== 'N/A' && f !== 'False');
            }

            document.getElementById('btnCreateRequest').addEventListener('click', function() {
                if (checkProfileComplete()) {
                    new bootstrap.Modal(document.getElementById('createAppointmentModal')).show();
                } else {
                    alert('Please complete your profile first before creating a request.');
                    new bootstrap.Modal(document.getElementById('editProfileModal')).show();
                }
            });

            document.getElementById('btnSubmitComplaint').addEventListener('click', function() {
                if (checkProfileComplete()) { 
                    new bootstrap.Modal(document.getElementById('complaintModal')).show();
                } else {
                    alert('Please complete your profile first before submitting a complaint.');
                    new bootstrap.Modal(document.getElementById('editProfileModal')).show();
                }
            });

            // Generic function to handle image previews
            function setupImagePreview(inputId, errorId, previewId) {
                const input = document.querySelector(`input[name="${inputId}"]`);
                if (input) {
                    input.addEventListener('change', function() {
                        const err = document.getElementById(errorId);
                        const preview = document.getElementById(previewId);

                        if (err) err.textContent = '';

                        const file = this.files[0];
                        if (!file) return;

                        if (!file.type.startsWith('image/')) {
                            if (err) err.textContent = 'Please choose an image file (JPG or PNG).';
                            this.value = '';
                            return;
                        }
                        if (file.size > 5 * 1024 * 1024) {
                            if (err) err.textContent = 'Photo is too large. Maximum is 5MB.';
                            this.value = '';
                            return;
                        }
                        if (preview) {
                            preview.src = URL.createObjectURL(file);
                            preview.classList.remove('d-none'); // Reveal the img tag if it was hidden
                        }
                    });
                }
            }

            // Initialize previews for all 3 file inputs
            setupImagePreview('ProfilePicture', 'pictureError', 'picturePreview');
            setupImagePreview('IdentificationFront', 'idFrontError', 'idFrontPreview');
            setupImagePreview('IdentificationBack', 'idBackError', 'idBackPreview');
    </script>
</body>
</html>