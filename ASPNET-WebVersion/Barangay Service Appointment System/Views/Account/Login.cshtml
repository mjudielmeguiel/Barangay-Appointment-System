@model AppointmentSystem.Models.UserLoginModel
@{
    Layout = null;
    var openModal = !ViewData.ModelState.IsValid;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#111d3c" />
    <title>Barangay Service Management System</title>
    <link rel="icon" type="image/x-icon" href="~/images/PUTATAN.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
    <style>
        :root {
            --brand: #192a56;
            --brand-dark: #111d3c;
            --brand-soft: #273c75;
            --brand-light: #3d5a9e;
            --bg: #f5f6fa;
            --ease: cubic-bezier(.4, 0, .2, 1);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', 'Segoe UI', Tahoma, sans-serif; -webkit-tap-highlight-color: transparent; }
        html { scroll-behavior: smooth; scroll-padding-top: 90px; -webkit-text-size-adjust: 100%; }
        body { background: var(--bg); color: #2f3640; overflow-x: hidden; }
        img { max-width: 100%; }
        .container { width: 90%; max-width: 1240px; margin: 0 auto; }

        /* ===== Header (blends into hero: same starting color) ===== */
        header { background: var(--brand-dark); position: sticky; top: 0; z-index: 50; transition: box-shadow .35s var(--ease), background .35s var(--ease); }
        header.scrolled { box-shadow: 0 6px 24px rgba(10, 18, 40, .35); background: rgba(17, 29, 60, .96); backdrop-filter: blur(8px); }
        .nav { display: flex; align-items: center; justify-content: space-between; height: 84px; gap: 16px; }

        /* Logo: borderless, no background, no frame */
        .brand { display: flex; align-items: center; gap: 14px; color: #fff; text-decoration: none; min-width: 0; transition: opacity .3s var(--ease); }
        .brand:hover { opacity: .88; }
        .brand img { width: 52px; height: 52px; object-fit: contain; border: 0; outline: 0; background: none; padding: 0; border-radius: 0; flex-shrink: 0; transition: transform .35s var(--ease); }
        .brand:hover img { transform: scale(1.06); }
        .brand strong { display: block; font-size: 19px; font-weight: 700; line-height: 1.2; }
        .brand span { display: block; font-size: 11.5px; font-weight: 500; color: #c9d1e6; }

        .nav-right { display: flex; align-items: center; gap: 26px; }
        .nav-links { display: flex; align-items: center; gap: 26px; }
        .nav-links a { position: relative; color: #fff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 6px 0; transition: color .3s var(--ease); }
        .nav-links a::after { content: ''; position: absolute; left: 0; bottom: 0; width: 0; height: 2px; background: #fff; border-radius: 2px; transition: width .35s var(--ease); }
        .nav-links a:hover::after { width: 100%; }

        .btn-open-login { background: #fff; color: var(--brand); border: none; padding: 10px 24px; border-radius: 6px; font-size: 14px; font-weight: 700; cursor: pointer; white-space: nowrap; transition: transform .3s var(--ease), box-shadow .3s var(--ease), background .3s var(--ease), color .3s var(--ease); }
        .btn-open-login i { margin-right: 7px; transition: transform .3s var(--ease); }
        .btn-open-login:hover { background: #e8ecf8; transform: translateY(-2px); box-shadow: 0 8px 18px rgba(0, 0, 0, .25); }
        .btn-open-login:hover i { transform: translateX(3px); }
        .btn-open-login:active { transform: translateY(0); }

        .btn-open-register { background: transparent; color: #fff; border: 2px solid #fff; padding: 8px 22px; border-radius: 6px; font-size: 14px; font-weight: 700; cursor: pointer; white-space: nowrap; transition: background .3s var(--ease), color .3s var(--ease); }
        .btn-open-register i { margin-right: 7px; }
        .btn-open-register:hover { background: #fff; color: var(--brand); }

        .menu-toggle { display: none; background: none; border: none; color: #fff; font-size: 22px; width: 42px; height: 42px; border-radius: 8px; cursor: pointer; transition: background .3s var(--ease); }
        .menu-toggle:hover { background: rgba(255, 255, 255, .12); }

        /* ===== Hero (soft blended gradient, fades into page) ===== */
        .hero { position: relative; color: #fff; padding: clamp(48px, 8vw, 84px) 0 clamp(70px, 10vw, 110px); overflow: hidden;
            background:
                radial-gradient(circle at 85% 20%, rgba(61, 90, 158, .45), transparent 45%),
                radial-gradient(circle at 10% 90%, rgba(39, 60, 117, .55), transparent 50%),
                linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 55%, var(--brand-soft) 100%); }
        .hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 70px; background: linear-gradient(to bottom, rgba(245, 246, 250, 0), var(--bg)); pointer-events: none; }
        .hero .container { position: relative; z-index: 1; }
        .hero h1 { font-size: clamp(28px, 5vw, 46px); font-weight: 800; line-height: 1.2; margin-bottom: 20px; }
        .hero p { max-width: 700px; font-size: clamp(14px, 2vw, 16px); line-height: 1.8; color: #e3e8f5; }
        .btn-hero { display: inline-block; margin-top: 28px; background: #fff; color: var(--brand); padding: 13px 24px; border-radius: 6px; font-weight: 700; font-size: 15px; border: none; cursor: pointer; transition: transform .3s var(--ease), box-shadow .3s var(--ease), background .3s var(--ease); }
        .btn-hero:hover { background: #e8ecf8; transform: translateY(-3px); box-shadow: 0 12px 24px rgba(0, 0, 0, .25); }
        .btn-hero:active { transform: translateY(0); }

        /* ===== Services ===== */
        .section { padding: clamp(36px, 6vw, 56px) 0 30px; text-align: center; }
        .section h2 { font-size: clamp(21px, 3.4vw, 27px); color: var(--brand); font-weight: 700; }
        .section .sub { font-size: 13px; color: #718093; margin: 8px 0 32px; }
        .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: left; }
        .card { background: #fff; border-top: 4px solid var(--brand); border-radius: 10px; padding: 28px 24px 26px; box-shadow: 0 2px 12px rgba(25, 42, 86, .08); transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s var(--ease); }
        .card i { font-size: 28px; color: var(--brand); margin-bottom: 18px; display: block; transition: transform .35s var(--ease), color .35s var(--ease); }
        .card h3 { font-size: 18px; color: var(--brand); margin-bottom: 8px; transition: color .3s var(--ease); }
        .card p { font-size: 13px; line-height: 1.65; color: #718093; }
        .card:hover { transform: translateY(-6px); box-shadow: 0 14px 30px rgba(25, 42, 86, .18); border-color: var(--brand-light); }
        .card:hover i { transform: scale(1.15) rotate(-4deg); color: var(--brand-light); }
        .card:hover h3 { color: var(--brand-light); }

        /* ===== Contact Us (blends softly from page background) ===== */
        .contact { background: linear-gradient(180deg, var(--bg) 0%, #f3f3f3 100%); padding: 28px 0 clamp(40px, 6vw, 64px); text-align: left; }
        .contact-title { font-size: clamp(21px, 3vw, 24px); font-weight: 600; color: #ffc700; margin-bottom: 26px; }
        .contact-top { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 6vw, 70px); margin-bottom: 40px; }
        .contact-left h2 { font-size: clamp(24px, 3.6vw, 32px); line-height: 1.45; font-weight: 700; color: #0b1a4a; margin-bottom: 22px; }
        .contact-left p { font-size: clamp(14px, 1.8vw, 16px); line-height: 1.7; color: #111; }
        .contact-right h3 { font-size: clamp(18px, 2.4vw, 22px); font-weight: 700; margin-bottom: 4px; }
        .contact-right .loc { color: #c8102e; }
        .contact-right .fb { color: #0b1a4a; margin-top: 18px; }
        .contact-right p { font-size: clamp(14px, 1.8vw, 16px); line-height: 1.7; color: #0b1a4a; word-break: break-word; }
        .contact-right p.addr { color: #111; }
        .hotlines-title { font-size: clamp(21px, 3vw, 24px); font-weight: 600; color: #ff9f0a; margin-bottom: 22px; }
        .hot-card { background: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(25, 42, 86, .07); overflow: hidden; padding-bottom: 28px; transition: box-shadow .35s var(--ease); }
        .hot-card:hover { box-shadow: 0 8px 26px rgba(25, 42, 86, .13); }
        .hot-tabs { display: flex; border-bottom: 1px solid #dfe3e8; overflow-x: auto; }
        .hot-tab { background: none; border: none; border-bottom: 2px solid transparent; padding: 18px 16px; font-size: 14px; font-weight: 600; cursor: pointer; margin-bottom: -1px; white-space: nowrap; transition: background .3s var(--ease), border-color .3s var(--ease), opacity .3s var(--ease); }
        .hot-tab.t-red { color: #c8102e; }
        .hot-tab.t-yellow { color: #ffc700; }
        .hot-tab:hover { background: #f8f9fc; border-bottom-color: #cfd6e6; }
        .hot-tab.active { border-bottom-color: #222; }
        .hot-body { margin: 18px 18px 0; }
        .hot-search { background: #f8f9fa; padding: 15px 14px; border-bottom: 1px solid #dfe3e8; }
        .hot-search input { width: 368px; max-width: 100%; padding: 10px; border: 1px solid #ced4da; border-radius: 6px; font-size: 13px; color: #495057; background: #fff; outline: none; transition: border-color .3s var(--ease), box-shadow .3s var(--ease); }
        .hot-search input:hover { border-color: #a9b4cc; }
        .hot-search input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(25, 42, 86, .12); }
        .hot-table { width: 100%; border-collapse: collapse; font-size: 13px; color: #333; }
        .hot-table th { background: #f8f9fa; text-align: left; font-weight: 600; font-size: 14px; color: #333; padding: 16px 14px; border-bottom: 1px solid #dfe3e8; }
        .hot-table td { padding: 24px 14px; border-bottom: 1px solid #e9ecef; transition: background .3s var(--ease); }
        .hot-table tbody tr { transition: background .3s var(--ease); }
        .hot-table tbody tr:hover { background: #f4f6fc; }
        .hot-table td a { color: #0a0a8a; font-weight: 700; text-decoration: underline; transition: color .3s var(--ease), letter-spacing .3s var(--ease); }
        .hot-table td a:hover { color: #c8102e; letter-spacing: .5px; }
        .hot-pager { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 16px; color: #888; font-size: 14px; flex-wrap: wrap; }
        .hot-pager .pg { color: #aaa; font-size: 15px; cursor: pointer; transition: color .3s var(--ease), transform .3s var(--ease); }
        .hot-pager .pg:hover { color: var(--brand); transform: scale(1.25); }
        .hot-pager .cur { background: #e8f1fd; color: #1a73e8; width: 43px; height: 43px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: background .3s var(--ease), color .3s var(--ease); }
        .hot-pager .cur:hover { background: #1a73e8; color: #fff; }

        /* ===== Footer (blended gradient) ===== */
        footer { background: linear-gradient(135deg, var(--brand-dark), var(--brand)); color: #c9d1e6; text-align: center; padding: 22px 16px; font-size: 12px; }

        /* ===== Scroll reveal ===== */
        .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
        .reveal.show { opacity: 1; transform: none; }

        /* ===== Modals ===== */
        .modal-backdrop { position: fixed; inset: 0; background: rgba(10, 18, 40, .6); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; padding: 16px; z-index: 1000; opacity: 0; visibility: hidden; transition: opacity .35s var(--ease), visibility .35s var(--ease); overflow-y: auto; }
        .modal-backdrop.open { opacity: 1; visibility: visible; }
        .login-card { position: relative; width: 100%; max-width: 380px; max-height: 94vh; overflow-y: auto; background: linear-gradient(180deg, #ffffff 0%, #f7f9ff 100%); border-radius: 14px; padding: 34px 32px 28px; box-shadow: 0 20px 50px rgba(0, 0, 0, .4); text-align: left; transform: translateY(-18px) scale(.97); transition: transform .4s var(--ease); }
        .modal-backdrop.open .login-card { transform: none; }
        .modal-close { position: absolute; top: 10px; right: 12px; background: none; border: none; font-size: 22px; line-height: 1; width: 34px; height: 34px; border-radius: 50%; color: #a4b0be; cursor: pointer; transition: color .3s var(--ease), background .3s var(--ease), transform .3s var(--ease); }
        .modal-close:hover { color: var(--brand); background: #eef1f9; transform: rotate(90deg); }
        .avatar { width: 80px; height: 80px; margin: 0 auto 12px; display: flex; align-items: center; justify-content: center; }
        .avatar img { width: 100%; height: 100%; object-fit: contain; border: 0; background: none; padding: 0; border-radius: 0; transition: transform .4s var(--ease); }
        .login-card:hover .avatar img { transform: scale(1.06); }
        .login-card h2 { text-align: center; font-size: 22px; font-weight: 300; color: #2f3640; margin-bottom: 24px; }
        
        .form-row { display: flex; gap: 10px; margin-bottom: 14px; }
        .form-row .form-group { margin-bottom: 0; flex: 1; }
        
        .form-group { margin-bottom: 14px; }
        .form-control { width: 100%; padding: 12px; background: #fff; border: 1px solid #dfe4ea; border-radius: 6px; font-size: 14px; color: #2f3640; outline: none; transition: border-color .3s var(--ease), box-shadow .3s var(--ease); }
        .form-control::placeholder { color: #a4b0be; }
        .form-control:hover { border-color: #a9b4cc; }
        .form-control:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(25, 42, 86, .13); }
        .btn-login { width: 100%; padding: 12px; margin-top: 6px; background: linear-gradient(135deg, var(--brand), var(--brand-soft)); color: #fff; border: none; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; transition: transform .3s var(--ease), box-shadow .3s var(--ease), filter .3s var(--ease); }
        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(25, 42, 86, .3); filter: brightness(1.1); }
        .btn-login:active { transform: translateY(0); }
        .login-options { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; font-size: 12px; gap: 8px; flex-wrap: wrap; }
        .remember { display: flex; align-items: center; gap: 6px; color: var(--brand); cursor: pointer; }
        .remember input { width: 15px; height: 15px; accent-color: var(--brand); cursor: pointer; }
        .login-options a { color: var(--brand); text-decoration: none; transition: color .3s var(--ease); }
        .login-options a:hover { color: var(--brand-light); text-decoration: underline; }
        .text-danger { color: #e74c3c; font-size: 12px; margin-top: 4px; display: block; }
        .validation-summary { margin-bottom: 12px; text-align: center; }

        /* ===== Tablet ===== */
        @@media (max-width: 992px) {
            .cards { grid-template-columns: repeat(2, 1fr); }
            .nav-right { gap: 12px; }
            .menu-toggle { display: inline-flex; align-items: center; justify-content: center; }
            .nav-links { position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; background: var(--brand-dark); padding: 6px 5% 14px; box-shadow: 0 14px 24px rgba(10, 18, 40, .35); max-height: 0; overflow: hidden; opacity: 0; visibility: hidden; transition: max-height .4s var(--ease), opacity .3s var(--ease), visibility .3s var(--ease); }
            .nav-links.open { max-height: 320px; opacity: 1; visibility: visible; }
            .nav-links a { padding: 14px 4px; border-bottom: 1px solid rgba(255, 255, 255, .08); }
            .nav-links a::after { display: none; }
            .nav-links a:hover { color: #aebbe0; }
        }

        /* ===== Phone ===== */
        @@media (max-width: 768px) {
            .nav { height: 70px; }
            .brand img { width: 42px; height: 42px; }
            .brand strong { font-size: 15px; }
            .brand span { display: none; }
            .contact-top { grid-template-columns: 1fr; }
            .hot-body { margin: 12px 12px 0; }
            .hot-search input { width: 100%; }
            .btn-open-login { padding: 9px 16px; font-size: 13px; }
            .btn-open-register { padding: 9px 16px; font-size: 13px; }

            /* table becomes stacked cards */
            .hot-table thead { display: none; }
            .hot-table, .hot-table tbody { display: block; }
            .hot-table tbody tr { display: block; border: 1px solid #e9ecef; border-radius: 8px; margin: 12px 0; padding: 6px 0; }
            .hot-table td { display: flex; justify-content: space-between; gap: 14px; padding: 10px 14px; border-bottom: 1px dashed #eceff4; text-align: right; }
            .hot-table td:last-child { border-bottom: none; }
            .hot-table td::before { content: attr(data-label); font-weight: 600; color: #333; text-align: left; flex-shrink: 0; }
        }
        @@media (max-width: 560px) {
            .cards { grid-template-columns: 1fr; }
            .btn-hero { width: 100%; text-align: center; }
            .brand strong { font-size: 13.5px; max-width: 150px; }
            .btn-open-login i, .btn-open-register i { display: none; }
            .login-card { padding: 28px 22px 22px; }
        }
        @@media (hover: none) {
            .card:hover, .btn-hero:hover, .btn-open-login:hover, .btn-open-register:hover, .btn-login:hover { transform: none; }
        }
        @@media (prefers-reduced-motion: reduce) {
            * { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
            .reveal { opacity: 1; transform: none; }
        }
    </style>
</head>
<body>

    <!-- ===== Header ===== -->
    <header id="siteHeader">
        <div class="container nav">
            <a href="#home" class="brand">
                <img src="~/images/PUTATAN.ico" alt="PUTATAN logo" />
                <div>
                    <strong>Barangay Service Management</strong>
                    <span>Web-Based Document Request and Processing System</span>
                </div>
            </a>
            <div class="nav-right">
                <nav class="nav-links" id="navLinks">
                    <a href="#home">Home</a>
                    <a href="#services">Services</a>
                    <a href="#request">Request</a>
                    <a href="#contact">Contact</a>
                </nav>
                <button type="button" class="btn-open-register" id="openRegister"><i class="fa-solid fa-user-plus"></i>Create Account</button>
                <button type="button" class="btn-open-login" id="openLogin"><i class="fa-solid fa-right-to-bracket"></i>Login</button>
                <button type="button" class="menu-toggle" id="menuToggle" aria-label="Menu"><i class="fa-solid fa-bars"></i></button>
            </div>
        </div>
    </header>

    <!-- ===== Hero ===== -->
    <section class="hero" id="home">
        <div class="container reveal">
            <h1>Barangay Services Made Easier</h1>
            <p>Welcome to the Barangay Service Management System. Residents can view available services, submit document requests, and check the current status of their requests through this website.</p>
            <button type="button" class="btn-hero" id="requestDoc">Request a Document</button>
        </div>
    </section>

    <!-- ===== Services ===== -->
    <section class="section" id="services">
        <div class="container reveal">
            <h2>Available Barangay Services</h2>
            <p class="sub">Select a service that you need.</p>
            <div class="cards" id="request">
                <div class="card">
                    <i class="fa-regular fa-file-lines"></i>
                    <h3>Barangay Clearance</h3>
                    <p>Request a barangay clearance for employment, school, business, or other purposes.</p>
                </div>
                <div class="card">
                    <i class="fa-solid fa-house-chimney"></i>
                    <h3>Certificate of Residency</h3>
                    <p>Request proof that you are a resident of the barangay.</p>
                </div>
                <div class="card">
                    <i class="fa-solid fa-user"></i>
                    <h3>Certificate of Indigency</h3>
                    <p>Submit a request for a certificate of indigency for valid purposes.</p>
                </div>
                <div class="card">
                    <i class="fa-solid fa-briefcase"></i>
                    <h3>Business Clearance</h3>
                    <p>Request a barangay business clearance for your business application.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== Contact Us ===== -->
    <section class="contact" id="contact">
        <div class="container reveal">
            <div class="contact-title">Contact Us!</div>

            <div class="contact-top">
                <div class="contact-left">
                    <h2>Don't hesitate to<br />contact us if you need<br />more help!</h2>
                    <p>We're here to assist you in any way we can. Whether you have questions, feedback, or need support, please don't hesitate to reach out to us. Your input and inquiries are important to us as we strive to enhance your Smart Barangay experience.</p>
                </div>
                <div class="contact-right">
                    <h3 class="loc">Location</h3>
                    <p class="addr">Barangay Putatan Hall, Bruger Street, Putatan 1772 Muntinlupa City, Philippines</p>
                    <p class="addr"><strong>OPEN:</strong>&nbsp; M-F 8:00AM-5:00PM</p>
                    <h3 class="fb">Facebook</h3>
                    <p>Barangay Putatan Muntinlupa<br />facebook.com/putatanmuntinlupa.official</p>
                </div>
            </div>

            <div class="hotlines-title">Hotlines</div>
            <div class="hot-card">
                <div class="hot-tabs">
                    <button type="button" class="hot-tab t-red active" data-tab="emergency">Emergency Hotlines</button>
                    <button type="button" class="hot-tab t-yellow" data-tab="general">General Hotlines</button>
                </div>
                <div class="hot-body">
                    <div class="hot-search"><input type="text" id="hotSearch" placeholder="Search for.." /></div>

                    <table class="hot-table" id="tbl-emergency">
                        <thead><tr><th>Agency Name</th><th>Phone Number</th><th>Specialization</th><th>Coverage</th></tr></thead>
                        <tbody>
                            <tr><td data-label="Agency Name">Muntinlupa Emergency Hotline</td><td data-label="Phone Number"><a href="tel:00137175">00137175</a></td><td data-label="Specialization">All Emergency Necessities</td><td data-label="Coverage">Entire Muntinlupa City</td></tr>
                            <tr><td data-label="Agency Name">BDRRM/Fire</td><td data-label="Phone Number"><a href="tel:86600144">86600144</a></td><td data-label="Specialization">Disaster Risk Reduction &amp; Fire Rescue</td><td data-label="Coverage">Barangay Putatan &amp; Nearby Area</td></tr>
                            <tr><td data-label="Agency Name">Medical Rescue</td><td data-label="Phone Number"><a href="tel:84615250">84615250</a></td><td data-label="Specialization">Medical Emergency</td><td data-label="Coverage">Barangay Putatan &amp; Nearby Area</td></tr>
                            <tr><td data-label="Agency Name">Barangay Police</td><td data-label="Phone Number"><a href="tel:86600287">86600287</a></td><td data-label="Specialization">Safety &amp; Security</td><td data-label="Coverage">Barangay Putatan</td></tr>
                        </tbody>
                    </table>

                    <table class="hot-table" id="tbl-general" style="display:none">
                        <thead><tr><th>Agency Name</th><th>Phone Number</th><th>Specialization</th><th>Coverage</th></tr></thead>
                        <tbody>
                            <tr><td data-label="Agency Name">Barangay Police</td><td data-label="Phone Number"><a href="tel:86600287">86600287</a></td><td data-label="Specialization">Safety &amp; Security</td><td data-label="Coverage">Barangay Putatan</td></tr>
                            <tr><td data-label="Agency Name">Violence Against Women &amp; Children</td><td data-label="Phone Number"><a href="tel:86600135">86600135</a></td><td data-label="Specialization">Protection &amp; Support for Women &amp; Children</td><td data-label="Coverage">Barangay Putatan</td></tr>
                        </tbody>
                    </table>

                    <div class="hot-pager">
                        <span>1 of 1</span>
                        <span class="pg">&laquo;</span>
                        <span class="pg">&lsaquo;</span>
                        <span class="cur">1</span>
                        <span class="pg">&rsaquo;</span>
                        <span class="pg">&raquo;</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer>&copy; 2026 BSMS All rights reserved.</footer>

    <!-- ===== Login Modal ===== -->
    <div class="modal-backdrop @(openModal ? "open" : "")" id="loginModal">
        <div class="login-card" role="dialog" aria-modal="true" aria-labelledby="loginTitle">
            <button type="button" class="modal-close" id="closeLogin" aria-label="Close">&times;</button>

            <div class="avatar">
                <img src="~/images/PUTATAN.ico" alt="PUTATAN logo" />
            </div>
            <h2 id="loginTitle">Sign In</h2>

            <!-- In-update ang Login Form para magkaroon din ng asp-controller -->
            <form asp-action="Login" asp-controller="Account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

                <div class="form-group">
                    <input asp-for="Username" class="form-control" placeholder="Username" autocomplete="off" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input asp-for="Password" class="form-control" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-login">Login</button>

                <div class="login-options">
                    <label class="remember"><input type="checkbox" name="RememberMe" value="true" /> Remember Me</label>
                    <a href="#">Forgot Password</a>
                </div>
            </form>
        </div>
    </div>

    <!-- ===== Register Modal ===== -->
    <div class="modal-backdrop" id="registerModal">
        <div class="login-card" role="dialog" aria-modal="true" aria-labelledby="registerTitle">
            <button type="button" class="modal-close" id="closeRegister" aria-label="Close">&times;</button>

            <div class="avatar">
                <img src="~/images/PUTATAN.ico" alt="PUTATAN logo" />
            </div>
            <h2 id="registerTitle">Create Account</h2>

            <!-- In-update ang Register Form (Ito ang hiniling mo) -->
            <form asp-action="Register" asp-controller="Account" method="post" id="registerForm">
                
                <div class="form-row">
                    <div class="form-group">
                        <input name="Firstname" class="form-control" placeholder="First Name" required />
                    </div>
                    <div class="form-group">
                        <input name="Lastname" class="form-control" placeholder="Last Name" required />
                    </div>
                </div>

                <div class="form-group">
                    <input name="Email" type="email" class="form-control" placeholder="Email Address" required />
                </div>
                
                <div class="form-group">
                    <input name="Username" class="form-control" placeholder="Username" required minlength="4" />
                </div>

                <div class="form-group">
                    <input name="Password" type="password" id="regPassword" class="form-control" placeholder="Password" required minlength="6" />
                </div>
                
                <div class="form-group">
                    <input type="password" id="regConfirmPassword" class="form-control" placeholder="Confirm Password" required />
                    <span id="passwordError" class="text-danger" style="display:none; margin-top:5px;">Passwords do not match</span>
                </div>

                <button type="submit" class="btn-login" id="btnRegister">Register Account</button>
            </form>
        </div>
    </div>

    <script>
        (function () {
            var loginModal = document.getElementById('loginModal');
            var registerModal = document.getElementById('registerModal');
            var header = document.getElementById('siteHeader');
            var nav = document.getElementById('navLinks');
            var toggle = document.getElementById('menuToggle');

            function openLoginModal() { closeMenu(); registerModal.classList.remove('open'); loginModal.classList.add('open'); document.body.style.overflow = 'hidden'; var u = loginModal.querySelector('input[name="Username"]'); if (u) setTimeout(function () { u.focus(); }, 350); }
            function closeLoginModal() { loginModal.classList.remove('open'); checkBodyOverflow(); }
            
            function openRegisterModal() { closeMenu(); loginModal.classList.remove('open'); registerModal.classList.add('open'); document.body.style.overflow = 'hidden'; var f = registerModal.querySelector('input[name="Firstname"]'); if (f) setTimeout(function () { f.focus(); }, 350); }
            function closeRegisterModal() { registerModal.classList.remove('open'); checkBodyOverflow(); }
            
            function checkBodyOverflow() { if(!loginModal.classList.contains('open') && !registerModal.classList.contains('open')){ document.body.style.overflow = ''; } }
            function closeMenu() { nav.classList.remove('open'); toggle.innerHTML = '<i class="fa-solid fa-bars"></i>'; }

            // Trigger Modal Logics
            document.getElementById('openLogin').addEventListener('click', openLoginModal);
            document.getElementById('requestDoc').addEventListener('click', openLoginModal);
            document.getElementById('closeLogin').addEventListener('click', closeLoginModal);
            
            document.getElementById('openRegister').addEventListener('click', openRegisterModal);
            document.getElementById('closeRegister').addEventListener('click', closeRegisterModal);

            loginModal.addEventListener('click', function (e) { if (e.target === loginModal) closeLoginModal(); });
            registerModal.addEventListener('click', function (e) { if (e.target === registerModal) closeRegisterModal(); });
            
            document.addEventListener('keydown', function (e) { 
                if (e.key === 'Escape') { closeLoginModal(); closeRegisterModal(); } 
            });
            if (loginModal.classList.contains('open')) document.body.style.overflow = 'hidden';

            // Registration Form Password Validation
            var regForm = document.getElementById('registerForm');
            var pw = document.getElementById('regPassword');
            var confirmPw = document.getElementById('regConfirmPassword');
            var pwError = document.getElementById('passwordError');
            
            regForm.addEventListener('submit', function(e) {
                if (pw.value !== confirmPw.value) {
                    e.preventDefault();
                    pwError.style.display = 'block';
                    confirmPw.style.borderColor = '#e74c3c';
                } else {
                    pwError.style.display = 'none';
                    confirmPw.style.borderColor = '';
                }
            });
            
            // Clear Validation warnings on Input change
            confirmPw.addEventListener('input', function() {
                 pwError.style.display = 'none';
                 confirmPw.style.borderColor = '';
            });

            // Mobile menu
            toggle.addEventListener('click', function () {
                var open = nav.classList.toggle('open');
                toggle.innerHTML = open ? '<i class="fa-solid fa-xmark"></i>' : '<i class="fa-solid fa-bars"></i>';
            });
            nav.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', closeMenu); });

            // Header shadow on scroll
            function onScroll() { header.classList.toggle('scrolled', window.scrollY > 10); }
            window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

            // Scroll reveal
            var items = document.querySelectorAll('.reveal');
            if ('IntersectionObserver' in window) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('show'); io.unobserve(en.target); } });
                }, { threshold: 0.12 });
                items.forEach(function (el) { io.observe(el); });
            } else { items.forEach(function (el) { el.classList.add('show'); }); }

            // Hotlines tabs + search
            var tabs = document.querySelectorAll('.hot-tab');
            var search = document.getElementById('hotSearch');
            var current = 'emergency';
            function filter() {
                var q = search.value.toLowerCase();
                document.querySelectorAll('#tbl-' + current + ' tbody tr').forEach(function (r) {
                    r.style.display = r.textContent.toLowerCase().indexOf(q) > -1 ? '' : 'none';
                });
            }
            tabs.forEach(function (t) {
                t.addEventListener('click', function () {
                    tabs.forEach(function (x) { x.classList.remove('active'); });
                    t.classList.add('active');
                    current = t.getAttribute('data-tab');
                    document.getElementById('tbl-emergency').style.display = current === 'emergency' ? '' : 'none';
                    document.getElementById('tbl-general').style.display = current === 'general' ? '' : 'none';
                    filter();
                });
            });
            search.addEventListener('input', filter);
            
            // Simple Alert if there are messages from Controller
            window.onload = function() {
                var successMsg = '@(TempData["SuccessMessage"])';
                var errorMsg = '@(TempData["ErrorMessage"])';
                
                if(successMsg) {
                    alert(successMsg);
                } else if(errorMsg) {
                    alert(errorMsg);
                }
            };
        })();
    </script>
</body>
</html>