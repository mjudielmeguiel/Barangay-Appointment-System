    Private Sub txtEmail_TextChanged(sender As Object, e As EventArgs) Handles txtEmail.TextChanged
        If isFormLoading OrElse (editingUserID.HasValue AndAlso editingSourceTable = "admin") Then Exit Sub ' ✅ THIS STOPPED THE CRASH

        Dim val = txtEmail.Text.Trim().ToLower()
        If String.IsNullOrWhiteSpace(val) Then
            SetFeedbackLabel(lblEmailError, "Will be saved as N/A", False)
            Exit Sub
        End If
        If Not Regex.IsMatch(val, "^[a-zA-Z0-9._%+-]+@gmail\.com$", RegexOptions.IgnoreCase) Then
            SetFeedbackLabel(lblEmailError, "Must end with @gmail.com", True)
            Exit Sub
        End If
        Try
            connection()
            Dim checkSql As String
            If editingUserID.HasValue Then
                checkSql = "SELECT COUNT(*) FROM users WHERE LOWER(Email)=LOWER(@email) AND UserID<>@uid AND Email <> 'N/A'"
            Else
                checkSql = "SELECT COUNT(*) FROM users WHERE LOWER(Email)=LOWER(@email) AND Email <> 'N/A'"
            End If
            Using cmd As New MySqlCommand(checkSql, cn)
                cmd.Parameters.AddWithValue("@email", val)
                If editingUserID.HasValue Then cmd.Parameters.AddWithValue("@uid", editingUserID.Value)
                Dim exists = Convert.ToInt32(cmd.ExecuteScalar()) > 0
                SetFeedbackLabel(lblEmailError, If(exists, "Email already registered!", "✓ OK"), exists)
            End Using
        Catch ex As Exception
            SetFeedbackLabel(lblEmailError, "Error verifying email.", True)
        Finally
            CloseConnection()
        End Try
    End Sub

    Private Sub txtContactNo_TextChanged(sender As Object, e As EventArgs) Handles txtContactNo.TextChanged
