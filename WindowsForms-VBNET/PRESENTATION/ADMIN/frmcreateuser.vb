    Private Sub txtUsername_TextChanged(sender As Object, e As EventArgs) Handles txtUsername.TextChanged
        If isFormLoading Then Exit Sub ' ✅ Prevent execution during load
        Dim val = txtUsername.Text.Trim()
        If String.IsNullOrWhiteSpace(val) Then
            SetFeedbackLabel(lblUsernameError, "Username is required.", True)
            Exit Sub
        End If
        If val.ToLower().Contains("admin") Then
            SetFeedbackLabel(lblUsernameError, "Username with 'admin' is prohibited.", True)
            Exit Sub
        End If
        Try
            connection()
            Dim checkSql As String
            If editingUserID.HasValue Then
                checkSql = If(editingSourceTable = "admin",
                    "SELECT COUNT(*) FROM admin WHERE LOWER(Username)=LOWER(@uname) AND AdminID<>@uid",
                    "SELECT COUNT(*) FROM users WHERE LOWER(Username)=LOWER(@uname) AND UserID<>@uid")
            Else
                checkSql = "SELECT COUNT(*) FROM users WHERE LOWER(Username)=LOWER(@uname)"
            End If
            Using cmd As New MySqlCommand(checkSql, cn)
                cmd.Parameters.AddWithValue("@uname", val)
                If editingUserID.HasValue Then cmd.Parameters.AddWithValue("@uid", editingUserID.Value)
                Dim exists = Convert.ToInt32(cmd.ExecuteScalar()) > 0
                SetFeedbackLabel(lblUsernameError, If(exists, "⚠️ Username already taken!", "✓ OK"), exists)
            End Using
        Catch ex As Exception
            SetFeedbackLabel(lblUsernameError, "Error verifying username.", True)
        Finally
            CloseConnection()
        End Try
    End Sub

    Private Sub txtPassword_TextChanged(sender As Object, e As EventArgs) Handles txtPassword.TextChanged, txtConfirmPass.TextChanged
        If isFormLoading Then Exit Sub ' ✅ Prevent execution during load
        Dim hasUpper = txtPassword.Text.Any(AddressOf Char.IsUpper)
        Dim hasLower = txtPassword.Text.Any(AddressOf Char.IsLower)
        If String.IsNullOrWhiteSpace(txtPassword.Text) Then
            SetFeedbackLabel(lblConfirmPassError, "Password is required.", True)
        ElseIf Not hasUpper OrElse Not hasLower OrElse txtPassword.Text.Length < 6 Then
            SetFeedbackLabel(lblConfirmPassError, "Min 6 chars — uppercase & lowercase.", True)
        ElseIf txtPassword.Text.Trim() <> txtConfirmPass.Text.Trim() Then
            SetFeedbackLabel(lblConfirmPassError, "Passwords do not match.", True)
        Else
            SetFeedbackLabel(lblConfirmPassError, "✓ Passwords Match", False)
        End If
    End Sub

    Private Sub btnSubmit_Click(sender As Object, e As EventArgs) Handles btnSubmit.Click
        If Not IsValidRole(cboRole.Text.Trim()) Then
            MsgBox("Selected role is invalid!", MsgBoxStyle.Exclamation)
            Return
        End If

        If editingSourceTable = "users" AndAlso Not editingUserID.HasValue Then
            If cboDepartment.SelectedIndex = -1 Then
                MsgBox("Please select a Department!", MsgBoxStyle.Exclamation)
                Return
            End If
            If cboAssignedOffice.SelectedIndex = -1 Then
                MsgBox("Please select a Satellite Office!", MsgBoxStyle.Exclamation)
                Return
            End If
        End If

        Dim hasError As Boolean = False
        If lblLastnameError.ForeColor = Color.Red Then hasError = True
        If lblFirstnameError.ForeColor = Color.Red Then hasError = True
        If lblConfirmPassError.ForeColor = Color.Red Then hasError = True
        If lblUsernameError.ForeColor = Color.Red Then hasError = True
        If editingSourceTable = "users" Then
            If lblEmailError.ForeColor = Color.Red AndAlso Not String.IsNullOrWhiteSpace(txtEmail.Text.Trim()) Then hasError = True
            If lblContactNoError.ForeColor = Color.Red AndAlso Not String.IsNullOrWhiteSpace(txtContactNo.Text.Trim()) Then hasError = True
            If lblRoleError.ForeColor = Color.Red Then hasError = True
            If lblAssignedOfficeError.ForeColor = Color.Red Then hasError = True
        End If

        If hasError Then
            MsgBox("Please fix all errors before submitting!", MsgBoxStyle.Exclamation)
            Return
        End If

        Dim fullName As String = $"{txtFirstname.Text.Trim()} {txtLastname.Text.Trim()}"
        If editingUserID.HasValue Then
            If MsgBox($"Are you sure you want to UPDATE user ""{fullName}""?",
                      MsgBoxStyle.YesNo + MsgBoxStyle.Question, "Confirm Update") = MsgBoxResult.No Then
                Return
            End If
        Else
            If MsgBox($"Are you sure you want to ADD NEW USER ""{fullName}""?",
                      MsgBoxStyle.YesNo + MsgBoxStyle.Question, "Confirm Save") = MsgBoxResult.No Then
                Return
            End If
        End If

        Try
            connection()
            Dim emailVal = If(String.IsNullOrWhiteSpace(txtEmail.Text.Trim()), "N/A", txtEmail.Text.Trim().ToLower())
            Dim contactVal = If(String.IsNullOrWhiteSpace(txtContactNo.Text.Trim()), "N/A", txtContactNo.Text.Trim())

            If editingUserID.HasValue Then
                Dim idCol = If(editingSourceTable = "admin", "AdminID", "UserID")
                Dim sql As String
                If editingSourceTable = "admin" Then
                    sql = "UPDATE admin SET Lastname=@lname, Firstname=@fname, Role=@role, Username=@uname, Password=@pass " &
                          "WHERE " & idCol & "=@uid"
                Else
                    sql = "UPDATE users SET Lastname=@lname, Firstname=@fname, Department=@dept, AssignedOffice=@office, " &
                          "Role=@role, Username=@uname, Password=@pass, Email=@email, ContactNumber=@contact " &
                          "WHERE " & idCol & "=@uid"
                End If
                Using cmd As New MySqlCommand(sql, cn)
                    cmd.Parameters.AddWithValue("@lname", txtLastname.Text.Trim().ToUpper())
                    cmd.Parameters.AddWithValue("@fname", txtFirstname.Text.Trim().ToUpper())
                    cmd.Parameters.AddWithValue("@role", cboRole.Text.Trim().ToUpper())
                    cmd.Parameters.AddWithValue("@uname", txtUsername.Text.Trim())
                    cmd.Parameters.AddWithValue("@pass", txtPassword.Text)
                    If editingSourceTable = "users" Then
                        cmd.Parameters.AddWithValue("@dept", cboDepartment.Text.Trim())
                        cmd.Parameters.AddWithValue("@office", If(cboAssignedOffice.SelectedIndex >= 0, cboAssignedOffice.Text.Trim(), DBNull.Value))
                        cmd.Parameters.AddWithValue("@email", emailVal)
                        cmd.Parameters.AddWithValue("@contact", contactVal)
                    End If
                    cmd.Parameters.AddWithValue("@uid", editingUserID.Value)
                    If cn.State = ConnectionState.Open Then cn.Close()
                    cn.Open()
                    cmd.ExecuteNonQuery()
                End Using
                MsgBox("User updated successfully!", MsgBoxStyle.Information)
                ReturnToManageUsers() ' ✅ Returns directly to the grid
            Else
                Dim freshStaffCode = GetNextStaffCode()
                Dim assignedOfficeText As String = If(cboAssignedOffice.SelectedIndex >= 0, cboAssignedOffice.Text.Trim(), "")
                Dim sql = "INSERT INTO users (StaffCode, Username, Password, Lastname, Firstname, Department, " &
                          "AssignedOffice, Role, Email, ContactNumber, AccountStatus, LoginAttempts) " &
                          "VALUES (@scode, @uname, @pass, @lname, @fname, @dept, @office, @role, @email, @contact, 'Active', 0)"
                Using cmd As New MySqlCommand(sql, cn)
                    cmd.Parameters.AddWithValue("@scode", freshStaffCode)
                    cmd.Parameters.AddWithValue("@uname", txtUsername.Text.Trim())
                    cmd.Parameters.AddWithValue("@pass", txtPassword.Text)
                    cmd.Parameters.AddWithValue("@lname", txtLastname.Text.Trim().ToUpper())
                    cmd.Parameters.AddWithValue("@fname", txtFirstname.Text.Trim().ToUpper())
                    cmd.Parameters.AddWithValue("@dept", cboDepartment.Text.Trim())
                    cmd.Parameters.AddWithValue("@office", assignedOfficeText)
                    cmd.Parameters.AddWithValue("@role", cboRole.Text.Trim().ToUpper())
                    cmd.Parameters.AddWithValue("@email", emailVal)
                    cmd.Parameters.AddWithValue("@contact", contactVal)
                    If cn.State = ConnectionState.Open Then cn.Close()
                    cn.Open()
                    cmd.ExecuteNonQuery()
                End Using
                MsgBox("Successfully Registered New User!", MsgBoxStyle.Information)
                ReturnToManageUsers() ' ✅ Returns directly to the grid
            End If
        Catch ex As MySqlException
            Dim errMsg As String = "Database Error: " & ex.Message
            If ex.Number = 1062 Then
                errMsg = "DUPLICATE FOUND!" & vbCrLf &
                         "— Username already exists" & vbCrLf &
                         "— Email already registered" & vbCrLf &
                         "— Contact Number already registered" & vbCrLf &
                         "Please use different values."
            End If
            MsgBox(errMsg, MsgBoxStyle.Critical)
        Catch ex As Exception
            MsgBox("Error: " & ex.Message, MsgBoxStyle.Critical)
        Finally
            CloseConnection()
        End Try
    End Sub

    Private Sub btnClearAll_Click(sender As Object, e As EventArgs) Handles btnClearAll.Click
        If editingUserID.HasValue Then
            If MsgBox("Clear all changes and reset to original values?",
                      MsgBoxStyle.YesNo + MsgBoxStyle.Question, "Confirm Clear") = MsgBoxResult.No Then
                Return
            End If
            LoadUserDataForEdit()
            ClearAllValidationLabels()
        Else
            If MsgBox("Cancel creation and go back?",
                      MsgBoxStyle.YesNo + MsgBoxStyle.Question, "Confirm Cancel") = MsgBoxResult.No Then
                Return
            End If
            ReturnToManageUsers() ' ✅ The back/clear button now correctly exits out of the form
        End If
    End Sub

    Private Sub ClearForm()
        txtLastname.Clear()
        txtFirstname.Clear()
        txtEmail.Clear()
        txtContactNo.Clear()
        txtUsername.Clear()
        txtUsername.Tag = "AutoGenerated"
        txtPassword.Clear()
        txtConfirmPass.Clear()
        cboRole.SelectedIndex = -1
        cboDepartment.SelectedIndex = -1
        cboAssignedOffice.SelectedIndex = -1
        ClearAllValidationLabels()
    End Sub

    Private Sub frmcreateuser_FormClosing(sender As Object, e As FormClosingEventArgs) Handles MyBase.FormClosing
        Dim mainForm As frmMain = TryCast(Application.OpenForms("frmMain"), frmMain)
        If mainForm IsNot Nothing Then
            mainForm.Enabled = True
            mainForm.Activate()
        End If
    End Sub
End Class