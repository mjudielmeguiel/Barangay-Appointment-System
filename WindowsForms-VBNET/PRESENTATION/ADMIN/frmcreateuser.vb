Imports MySql.Data.MySqlClient
Imports System.IO
Imports System.Text.RegularExpressions
Imports System.Runtime.InteropServices

Public Class frmcreateuser
    Private Const EM_SETCUEBANNER As Integer = &H1501
    Private Const CB_SETCUEBANNER As Integer = &H1703
    <DllImport("user32.dll", CharSet:=CharSet.Auto)>
    Private Shared Function SendMessage(hWnd As IntPtr, msg As Integer, wParam As Integer, <MarshalAs(UnmanagedType.LPWStr)> lParam As String) As IntPtr
    End Function

    Private editingUserID As Integer? = Nothing
    Private editingSourceTable As String = "users"
    Private isFormLoading As Boolean = False ' ✅ PREVENTS VALIDATION CRASHES DURING LOAD

    Public Sub New(ByVal userID As Integer, Optional ByVal srcTable As String = "users")
        InitializeComponent()
        editingUserID = userID
        editingSourceTable = srcTable
    End Sub

    Public Sub New()
        InitializeComponent()
    End Sub

    Private Sub frmcreateuser_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        isFormLoading = True ' Start loading flag

        InitializePlaceholders()

        If editingUserID.HasValue AndAlso editingSourceTable = "admin" Then
            cboDepartment.Visible = False
            lblRoleError.Visible = False
            txtEmail.Visible = False
            lblEmailError.Visible = False
            txtContactNo.Visible = False
            lblContactNoError.Visible = False
            cboAssignedOffice.Visible = False
            lblAssignedOfficeError.Visible = False
        Else
            cboDepartment.Visible = True
            lblRoleError.Visible = True
            txtEmail.Visible = True
            lblEmailError.Visible = True
            txtContactNo.Visible = True
            lblContactNoError.Visible = True
            cboAssignedOffice.Visible = True
            lblAssignedOfficeError.Visible = True
            LoadDepartmentsCombo()
            LoadSatelliteOfficesCombo()
        End If

        LoadRolesFromDatabase()

        If editingUserID.HasValue Then
            LoadUserDataForEdit()
            btnSubmit.Text = "Update User"
            Me.Text = "Edit User Information"
        Else
            txtUsername.Tag = "AutoGenerated"
            GenerateStaffCode()
            Me.Text = "Create New User"
        End If

        ClearAllValidationLabels()
        isFormLoading = False ' End loading flag
    End Sub

    Private Sub InitializePlaceholders()
        SendMessage(txtLastname.Handle, EM_SETCUEBANNER, 0, "DELA CRUZ")
        SendMessage(txtFirstname.Handle, EM_SETCUEBANNER, 0, "JUAN")
        SendMessage(txtUsername.Handle, EM_SETCUEBANNER, 0, "juandela01")
        SendMessage(txtEmail.Handle, EM_SETCUEBANNER, 0, "juan.delacruz@gmail.com")
        SendMessage(txtContactNo.Handle, EM_SETCUEBANNER, 0, "0912-345-6789")
        SendMessage(txtPassword.Handle, EM_SETCUEBANNER, 0, "Min. 6 chars: Aa123")
        SendMessage(txtConfirmPass.Handle, EM_SETCUEBANNER, 0, "Re-enter password")
        SendMessage(cboDepartment.Handle, CB_SETCUEBANNER, 0, "Select Department")
        SendMessage(cboAssignedOffice.Handle, CB_SETCUEBANNER, 0, "Select Satellite Office")
        SendMessage(cboRole.Handle, CB_SETCUEBANNER, 0, "Select Role")
    End Sub

    Private Sub LoadSatelliteOfficesCombo()
        Try
            connection()
            Dim sql = "SELECT id, satellite_office_number, facility_name, location_details " &
                      "FROM brgy_putatan_satellite_offices ORDER BY facility_name ASC"
            Dim dtOffices As New DataTable()
            Using localCmd As New MySqlCommand(sql, cn)
                Using adapter As New MySqlDataAdapter(localCmd)
                    adapter.Fill(dtOffices)
                End Using
            End Using
            If cboAssignedOffice IsNot Nothing Then
                cboAssignedOffice.DataSource = dtOffices
                cboAssignedOffice.DisplayMember = "facility_name"
                cboAssignedOffice.ValueMember = "id"
                cboAssignedOffice.SelectedIndex = -1
            End If
        Catch ex As Exception
            MsgBox("Error loading Satellite Offices: " & ex.Message, MsgBoxStyle.Exclamation)
        Finally
            CloseConnection()
        End Try
    End Sub

    Private Sub LoadDepartmentsCombo()
        Try
            connection()
            Dim sql = "SELECT DepartmentName FROM departments WHERE IsActive = 1 ORDER BY DepartmentName ASC"
            Dim dtDept As New DataTable()
            Using localCmd As New MySqlCommand(sql, cn)
                Using adapter As New MySqlDataAdapter(localCmd)
                    adapter.Fill(dtDept)
                End Using
            End Using
            If cboDepartment IsNot Nothing Then
                cboDepartment.DataSource = dtDept
                cboDepartment.DisplayMember = "DepartmentName"
                cboDepartment.ValueMember = "DepartmentName"
                cboDepartment.SelectedIndex = -1
            End If
        Catch ex As Exception
        Finally
            CloseConnection()
        End Try
    End Sub

    Private Sub LoadRolesFromDatabase()
        If cboRole Is Nothing Then Exit Sub
        cboRole.Items.Clear()
        Try
            connection()
            Dim sql = "SELECT RoleName FROM user_roles ORDER BY RoleName ASC"
            Using cmd As New MySqlCommand(sql, cn)
                If cn.State = ConnectionState.Open Then cn.Close()
                cn.Open()
                Using dr As MySqlDataReader = cmd.ExecuteReader()
                    While dr.Read()
                        cboRole.Items.Add(dr("RoleName").ToString().ToUpper())
                    End While
                End Using
            End Using
        Catch ex As Exception
            MsgBox("Error loading Roles: " & ex.Message, MsgBoxStyle.Critical)
        Finally
            CloseConnection()
        End Try
    End Sub

    Private Function IsValidRole(roleName As String) As Boolean
        If String.IsNullOrWhiteSpace(roleName) Then Return False
        Try
            connection()
            Dim sql = "SELECT COUNT(*) FROM user_roles WHERE UPPER(RoleName) = UPPER(@rname)"
            Using cmd As New MySqlCommand(sql, cn)
                cmd.Parameters.AddWithValue("@rname", roleName.Trim())
                Return Convert.ToInt32(cmd.ExecuteScalar()) > 0
            End Using
        Catch ex As Exception
            Return False
        Finally
            CloseConnection()
        End Try
    End Function

    Private Sub LoadUserDataForEdit()
        Try
            connection()
            Dim idCol As String = If(editingSourceTable = "admin", "AdminID", "UserID")
            Dim query As String
            If editingSourceTable = "admin" Then
                query = "SELECT Lastname, Firstname, Role, Username, Password FROM admin WHERE AdminID = @uid"
            Else
                query = "SELECT Lastname, Firstname, Department, AssignedOffice, Role, Username, Password, Email, ContactNumber, StaffCode " &
                        "FROM users WHERE UserID = @uid"
            End If
            Using cmd As New MySqlCommand(query, cn)
                cmd.Parameters.AddWithValue("@uid", editingUserID.Value)
                If cn.State = ConnectionState.Open Then cn.Close()
                cn.Open()
                Using dr As MySqlDataReader = cmd.ExecuteReader()
                    If dr.Read() Then
                        txtLastname.Text = If(IsDBNull(dr("Lastname")), "", dr("Lastname").ToString())
                        txtFirstname.Text = If(IsDBNull(dr("Firstname")), "", dr("Firstname").ToString())

                        If editingSourceTable = "users" Then
                            If Not IsDBNull(dr("Department")) Then
                                cboDepartment.Text = dr("Department").ToString()
                            End If
                            If Not IsDBNull(dr("AssignedOffice")) Then
                                cboAssignedOffice.Text = dr("AssignedOffice").ToString()
                            End If
                            If Not IsDBNull(dr("Email")) AndAlso dr("Email").ToString() <> "N/A" Then
                                txtEmail.Text = dr("Email").ToString()
                            Else
                                txtEmail.Text = ""
                            End If
                            If Not IsDBNull(dr("ContactNumber")) AndAlso dr("ContactNumber").ToString() <> "N/A" Then
                                txtContactNo.Text = dr("ContactNumber").ToString()
                            Else
                                txtContactNo.Text = ""
                            End If
                            If Not IsDBNull(dr("StaffCode")) Then
                                lblStaffCode.Text = dr("StaffCode").ToString()
                            End If
                        End If
                        If Not IsDBNull(dr("Role")) Then
                            cboRole.Text = dr("Role").ToString().ToUpper()
                        End If
                        txtUsername.Text = If(IsDBNull(dr("Username")), "", dr("Username").ToString())
                        txtUsername.Tag = "ManualEdited"
                        txtPassword.Text = If(IsDBNull(dr("Password")), "", dr("Password").ToString())
                        txtConfirmPass.Text = txtPassword.Text
                    End If
                End Using
            End Using
        Catch ex As Exception
            MsgBox("Error loading User Data: " & ex.Message, MsgBoxStyle.Critical)
        Finally
            CloseConnection()
        End Try
    End Sub

    ' ✅ NEW METHOD: Returns the user to the list panel after saving/updating
    Private Sub ReturnToManageUsers()
        Dim mainForm As frmMain = TryCast(Application.OpenForms("frmMain"), frmMain)
        If mainForm IsNot Nothing Then
            mainForm.Panel2.Controls.Clear()
            Dim frm As New frmManage_Users()
            frm.TopLevel = False
            frm.FormBorderStyle = FormBorderStyle.None
            frm.Dock = DockStyle.Fill
            mainForm.Panel2.Controls.Add(frm)
            frm.BringToFront()
            frm.Show()
        End If
    End Sub

    Private Sub frmcreateuser_KeyDown(sender As Object, e As KeyEventArgs) Handles MyBase.KeyDown
        If e.KeyCode = Keys.Enter Then
            e.SuppressKeyPress = True
            btnSubmit.PerformClick()
        End If
    End Sub

    Private Sub ConvertToUpperCase_KeyPress(sender As Object, e As KeyPressEventArgs) Handles txtLastname.KeyPress, txtFirstname.KeyPress
        If Not Char.IsLetter(e.KeyChar) AndAlso Not Char.IsControl(e.KeyChar) AndAlso
           e.KeyChar <> " "c AndAlso e.KeyChar <> "ñ"c AndAlso e.KeyChar <> "Ñ"c Then
            e.Handled = True
            Return
        End If
        If Char.IsLower(e.KeyChar) Then
            e.KeyChar = Char.ToUpper(e.KeyChar)
        End If
    End Sub

    Private Sub txtContactNo_KeyPress(sender As Object, e As KeyPressEventArgs) Handles txtContactNo.KeyPress
        If Not Char.IsDigit(e.KeyChar) AndAlso Not Char.IsControl(e.KeyChar) AndAlso e.KeyChar <> "-"c Then
            e.Handled = True
        End If
    End Sub

    Private Sub ClearAllValidationLabels()
        SetFeedbackLabel(lblLastnameError, "", False)
        SetFeedbackLabel(lblFirstnameError, "", False)
        SetFeedbackLabel(lblEmailError, "", False)
        SetFeedbackLabel(lblContactNoError, "", False)
        SetFeedbackLabel(lblUsernameError, "", False)
        SetFeedbackLabel(lblConfirmPassError, "", False)
        SetFeedbackLabel(lblRoleError, "", False)
        SetFeedbackLabel(lblAssignedOfficeError, "", False)
    End Sub

    Private Sub SetFeedbackLabel(lbl As Label, message As String, isError As Boolean)
        If lbl Is Nothing Then Exit Sub
        lbl.Text = message
        lbl.ForeColor = If(String.IsNullOrEmpty(message), Color.Black, If(isError, Color.Red, Color.Green))
    End Sub

    Private Function GetNextStaffCode() As String
        If editingUserID.HasValue Then Return lblStaffCode.Text
        Dim nextCode As String = "STF-001"
        Try
            connection()
            Dim sql = "SELECT StaffCode FROM users WHERE StaffCode LIKE 'STF-%' ORDER BY UserID DESC LIMIT 1"
            Using cmd As New MySqlCommand(sql, cn)
                If cn.State = ConnectionState.Open Then cn.Close()
                cn.Open()
                Using dr As MySqlDataReader = cmd.ExecuteReader()
                    If dr.Read() Then
                        Dim lastCode As String = dr("StaffCode").ToString()
                        If lastCode.Contains("-") Then
                            Dim parts = lastCode.Split("-"c)
                            If Integer.TryParse(parts(1), Nothing) Then
                                nextCode = "STF-" & (CInt(parts(1)) + 1).ToString("D3")
                            End If
                        End If
                    End If
                End Using
            End Using
        Catch ex As Exception
        Finally
            CloseConnection()
        End Try
        Return nextCode
    End Function

    Private Sub GenerateStaffCode()
        If Not editingUserID.HasValue Then
            lblStaffCode.Text = GetNextStaffCode()
        End If
    End Sub

    Private Sub cboRole_SelectedIndexChanged(sender As Object, e As EventArgs) Handles cboRole.SelectedIndexChanged
        If isFormLoading Then Exit Sub ' ✅ Prevent execution during load
        SetFeedbackLabel(lblRoleError, If(Not IsValidRole(cboRole.Text.Trim()), "Invalid role selected.", "✓ OK"), Not IsValidRole(cboRole.Text.Trim()))
        If Not editingUserID.HasValue Then UpdateUsernameSuggestion()
    End Sub

    Private Sub UpdateUsernameSuggestion() Handles txtFirstname.TextChanged, cboRole.SelectedIndexChanged
        If isFormLoading OrElse editingUserID.HasValue Then Exit Sub ' ✅ Prevent execution during load
        If txtUsername.Tag Is Nothing OrElse txtUsername.Tag.ToString() <> "AutoGenerated" Then Exit Sub
        If String.IsNullOrWhiteSpace(txtFirstname.Text) OrElse cboRole.SelectedIndex = -1 Then
            txtUsername.Clear()
            Exit Sub
        End If
        Dim cleanFirst = txtFirstname.Text.Trim().Replace(" ", "").Replace(".", "").ToLower()
        Dim cleanRole = cboRole.Text.Trim().Replace(" ", "").Replace(".", "").ToLower()
        Dim shortRole = If(cleanRole.Length >= 4, cleanRole.Substring(0, 4), cleanRole)
        Dim suggestedUser = $"{cleanFirst}{shortRole}"
        If suggestedUser.Contains("admin") Then suggestedUser &= "usr"
        Try
            connection()
            Dim counter = 1, checkUser = suggestedUser
            Do
                Using cmd As New MySqlCommand("SELECT Username FROM users WHERE LOWER(Username)=LOWER(@uname)", cn)
                    cmd.Parameters.AddWithValue("@uname", checkUser)
                    If cn.State = ConnectionState.Open Then cn.Close()
                    cn.Open()
                    Using dr = cmd.ExecuteReader()
                        If Not dr.HasRows Then Exit Do
                    End Using
                End Using
                checkUser = $"{suggestedUser}{counter}"
                counter += 1
            Loop
            txtUsername.Text = checkUser
            txtUsername.SelectionStart = txtUsername.TextLength
        Catch ex As Exception
            txtUsername.Text = suggestedUser
        Finally
            CloseConnection()
        End Try
    End Sub

